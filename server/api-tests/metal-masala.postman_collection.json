        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Meenakari Lotus Jhumka\",\n  \"slug\": \"meenakari-lotus-jhumka\",\n  \"tagline\": \"Vibrant hand-enameled lotus petals with dangling ghungroos.\",\n  \"price\": 899,\n  \"compareAtPrice\": 1199,\n  \"category\": \"cat-jhumkas\",\n  \"material\": \"brass\",\n  \"finish\": \"oxidized-silver\",\n  \"stock\": 10\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/products",
              "host": ["{{apiUrl}}"],
              "path": ["products"]
            }
          }
        }
      ]
