        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/categories",
              "host": ["{{apiUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Temple Jewellery\",\n  \"slug\": \"temple-jewellery\",\n  \"description\": \"Heirloom pieces inspired by traditional South Indian architecture.\"\n}"
            },
            "url": {
              "raw": "{{apiUrl}}/categories",
              "host": ["{{apiUrl}}"],
              "path": ["categories"]
            }
          }
        },
        {
          "name": "Delete Category (Conflict when in use)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{apiUrl}}/categories/jhumkas",
              "host": ["{{apiUrl}}"],
              "path": ["categories", "jhumkas"]
            }
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products (Default)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/products",
              "host": ["{{apiUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Filter Products (Category, Material, Price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/products?category=jhumkas&material=brass&minPrice=500&maxPrice=1500&sort=popular",
              "host": ["{{apiUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "jhumkas" },
                { "key": "material", "value": "brass" },
                { "key": "minPrice", "value": "500" },
                { "key": "maxPrice", "value": "1500" },
                { "key": "sort", "value": "popular" }
              ]
            }
          }
        },
        {
          "name": "Get Product by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiUrl}}/products/chandni-chowk-jhumka",
              "host": ["{{apiUrl}}"],
              "path": ["products", "chandni-chowk-jhumka"]
            }
          }
        },
        {
          "name": "Export Products CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{managerToken}}" }
            ],
            "url": {
              "raw": "{{apiUrl}}/products/export.csv",
              "host": ["{{apiUrl}}"],
              "path": ["products", "export.csv"]
