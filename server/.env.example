# development, test, or production. Set test in the shell to load .env.test.
NODE_ENV=development
# Express API listen port.
PORT=4000
# Raw Node HTTP demo listen port.
NATIVE_PORT=4001
# Browser origin allowed by CORS. Use an exact origin, without a trailing slash.
CLIENT_ORIGIN=http://localhost:5173
# Morgan format, or silent to disable normal request logging.
LOG_LEVEL=dev
# Phase 3 serves data from MongoDB (mongo) with json fallback for legacy testing.
DATA_STORE=mongo
# Optional JSON runtime directory, resolved from server/ when relative.
# DATA_STORE_DIR=data/store
# Database target for connection (local or atlas).
DB_TARGET=local
# Private Atlas connection string. Set only in a local .env or a secret manager.
# MONGODB_URI=
# Connection string for a local MongoDB instance.
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/metal_masala
# Database selected for the application.
DB_NAME=metal_masala
# AI service provider: mock, gemini, openai, anthropic. Defaults to mock for offline dev.
AI_PROVIDER=mock
# Optional API key for external LLM provider.
# AI_API_KEY=
# Optional model identifier.
# AI_MODEL=
# Minimum subtotal in rupees for free shipping.
FREE_SHIPPING_THRESHOLD=999
# Standard shipping charge in rupees.
SHIPPING_FEE=79
# Cash-on-delivery surcharge in rupees.
COD_FEE=49
# Report stock at or below this level as low.
LOW_STOCK_THRESHOLD=5
# Rate-limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# General request allowance in each window.
RATE_LIMIT_MAX=100

# Authentication. Generate two distinct values with `openssl rand -hex 32`.
# Leave both commented for ephemeral local keys. Required in production.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DEV_SEED_PASSWORD="ChangeMe#123"
