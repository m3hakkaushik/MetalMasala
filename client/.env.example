VITE_API_URL=/api/v1
VITE_SOCKET_URL=http://localhost:4000
# Phase 2 uses the real catalogue, pricing, newsletter, and contact endpoints.
# Set all for a standalone storefront demo.
VITE_MOCK_GROUPS=catalogue-extras,reviews,cart,orders,admin,ai,auth,users
